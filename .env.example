# Copy to `.env` for local Flutter runs (flutter_dotenv).

# Recommended: unified API (Gemini analyze + server-side prompts — no key in the app)
# Local dev: run server (bind all interfaces for phones on Wi‑Fi):
#   cd server && uvicorn app.main:app --host 0.0.0.0 --port 8080
# MD_API_BASE_URL=http://127.0.0.1:8080
# Physical phone on same Wi‑Fi: http://YOUR_PC_LAN_IP:8080  (NOT 127.0.0.1)
# Android emulator: MD_ANDROID_EMULATOR=true then http://127.0.0.1:8080 (rewrites to 10.0.2.2)
# Deployed (no trailing slash):
# MD_API_BASE_URL=https://your-app.up.railway.app

# Legacy: analysis-only base if MD_API_BASE_URL is unset
# AUDIO_ANALYSIS_BASE_URL=

# Client-side LLM (only when MD_API_BASE_URL is NOT set) — or save in Settings:
# OPENAI_API_KEY=        # LaoZhang (legacy env name)
# OPENROUTER_API_KEY=    # OpenRouter (sk-or-v1-…)
# Models (LaoZhang): gpt-5.5 multilingual prompt + claude-sonnet-4-5 lyrics/expression; gemini-2.5-flash analyze
#
# OpenRouter (optional): use an OpenRouter key (sk-or-v1-…) — app auto-detects and switches URL.
# Models (OpenRouter on-device): qwen/qwen3.7-max, mistralai/mistral-large, openai/gpt-4o-mini

# Server / Railway — LaoZhang default (no OPENROUTER_ONLY):
# OPENAI_API_KEY=   # LaoZhang key from https://api.laozhang.ai/token
# OPENAI_BASE_URL=https://api.laozhang.ai/v1   # optional; this is the default when unset
# PROMPT_PIPELINE=single   # opt-out; default hybrid = gpt-5.5 multilingual prompt + claude lyrics/expression
# REQUEST_TIMEOUT_SECONDS=360
# PROMPT_LLM_TIMEOUT_SECONDS=300
# PROMPT_VISION_MODEL=gpt-5.5
# PROMPT_DRAFT_MODEL=gpt-5.5
# PROMPT_POLISH_MODEL=claude-sonnet-4-5
# PROMPT_LYRICS_MODEL=claude-sonnet-4-5
# OPENAI_PRIMARY_MODEL=gpt-5.5
# ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
# ANALYSIS_MODE=librosa          # skip Gemini; librosa heuristics only
# LLM_TRACK_CLASSIFIER=true       # Gemini metadata+genre when AudD fails (default: on if API key set)
# METADATA_AI_RECONCILE=true       # legacy alias for LLM_TRACK_CLASSIFIER
# AUDD_API_KEY=
# AUDD_TIMEOUT_SECONDS=15        # AudD POST timeout
# AUDD_LOG_RAW=true              # log full AudD JSON response in server console
#
# OpenRouter on server (optional — does NOT change LaoZhang routing when unset):
# OPENROUTER_ONLY=true
# OPENROUTER_API_KEY=   # or OPENAI_API_KEY= OpenRouter key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://music-director.app
# OPENROUTER_APP_TITLE=Music Director
#
# ==============================================================================
# PROD — OpenRouter model routing (Qwen 3.7 Max + Mistral Large duo)
# Scoped to OpenRouter only — LaoZhang keeps gpt-5.5 / claude-sonnet-4-5 / gemini-2.5-* defaults.
# ==============================================================================
# STAGE 1 & 2: Foundational architecture & editorial alignment
# OPENROUTER_GENERATE_MODEL=qwen/qwen3.7-max
# THEME_CONSISTENCY_MODEL=qwen/qwen3.7-max
#
# STAGE 3: Creative humanization (lyric soul)
# HUMANIZATION_MODEL=mistralai/mistral-large
#
# STAGE 4 & 5: Hybrid polish & token compression
# PROMPT_POLISH_MODEL=qwen/qwen3.7-max
# SUNO_COMPRESSION_MODEL=qwen/qwen3.7-max
#
# Continuation follow-ups: max chars of prior output injected (head+tail window; default 6000).
# CONTINUATION_PRIOR_MAX_CHARS=6000
#
# OPENROUTER_POST_PROCESS=true
# THEME_CONSISTENCY_PASS=true
# HUMANIZATION_PASS=true
# SUNO_COMPRESSION_PASS=true

# Master prompt pack: V2 is DEFAULT. Set false for legacy word-budget prompt.
# USE_SUNO_PROMPT_V2=false
